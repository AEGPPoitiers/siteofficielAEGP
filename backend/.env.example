# Backend FastAPI — variables d'environnement (cf docs/CONTRAT-API.md §6)
# Copier en `.env` et remplir. NE JAMAIS commiter le `.env`.

# --- Supabase ---
# Dashboard Supabase → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=
# Dashboard Supabase → Settings → API (= VITE_SUPABASE_URL côté front)
SUPABASE_URL=
# Dashboard Supabase → Settings → API → service_role (secret — jamais côté front)
SUPABASE_SERVICE_ROLE_KEY=

# --- Backblaze B2 (bucket privé, S3-compatible) ---
B2_KEY_ID=
B2_APP_KEY=
# ex: https://s3.eu-central-003.backblazeb2.com
B2_ENDPOINT=
# ex: eu-central-003
B2_REGION=
# ex: siteaegp-tutorat
B2_BUCKET=

# --- Divers ---
# Origine du front (dev). En prod, les origines Vercel sont déjà autorisées dans main.py.
FRONTEND_URL=http://localhost:5173
